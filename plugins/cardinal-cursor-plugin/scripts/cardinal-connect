#!/usr/bin/env python3
"""Connect Cursor to Cardinal telemetry and MCP.

Runs Cardinal's device-code flow, mints ingest and MCP keys, verifies
both endpoints, writes a managed `mcpServers.cardinal` entry to
`~/.cursor/mcp.json`, and installs managed hooks in
`~/.cursor/hooks.json`. With `--project`, additionally writes
`.cursor/mcp.json` and `.cursor/hooks.json` at the repo root so
Cursor cloud agents (which do not load the user-level home directory)
pick up the same wiring.

Monorepo adapter: the device flow, endpoint probes, and file primitives
come from `cardinal_core` (vendored under ../hooks by build/vendor.py);
the Cursor-specific mcp.json / hooks.json managed-entry writers stay
here. See docs/specs/cursor-parity.md for the full contract.

`--owner-input on|off` does not connect: it records whether this
machine's Cursor sessions may record the prompts you type as owner input
of their Cardinal Investigation (owner_input.consent). It prints the full
text you consent to first, and `on` asks you to confirm it in this
terminal. Cursor has no channel to tell you that per session, so this
consent is the only way capture starts there.
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PLUGIN_ROOT / "hooks"))
from cardinal_core import deviceflow, tls  # noqa: E402
from cardinal_core.paths import atomic_write, atomic_write_secret, backup  # noqa: E402


def _load_plugin_version() -> str:
    manifest = PLUGIN_ROOT / ".cursor-plugin" / "plugin.json"
    try:
        return json.loads(manifest.read_text(encoding="utf-8")).get("version") or "unknown"
    except (OSError, ValueError):
        return "unknown"


PLUGIN_VERSION = _load_plugin_version()
CLIENT_ID = "cardinal-cursor-plugin"
MCP_SERVER_NAME = "cardinal"

HOOK_SCRIPT = PLUGIN_ROOT / "hooks" / "cardinal-cursor-telemetry.py"

# The identity marker embedded in every managed hook `command` string.
# Disconnect uses substring match on this to identify hook entries the
# plugin owns without needing a custom JSON field Cursor might reject.
HOOK_IDENTITY_MARKER = "cardinal-cursor-plugin"

# postToolUse also records submitted decisions: a cache-miss D18 tree
# listing (git ls-tree, <=5s), a `gh pr view` (<=1.5s), and OTLP posts
# (<=2s each) must fit inside Cursor's per-hook timeout.
POST_TOOL_USE_TIMEOUT_SECS = 15

# The storyboard authoring entry (`--role authoring`): the local preview
# render of Cardinal's storyboard__preview (core
# storyboard_authoring.PREVIEW_HOOK_TIMEOUT_S: the renderer stops at 120 s,
# the hook answers by 141 s) and the hero upload after storyboard__publish
# (<=7 s). Cursor documents a per-entry `timeout` in seconds with no stated
# maximum, and `matcher` on postToolUse, matched against `MCP:<tool_name>`
# for MCP tools (cursor.com/docs/agent/hooks). The matcher is written to
# match anywhere in the name, whether Cursor searches or full-matches;
# the hook checks the exact tool itself (AUTHORING_MATCHER there too).
AUTHORING_ROLE = "authoring"
AUTHORING_MATCHER = ".*storyboard__(preview|publish).*"
AUTHORING_TIMEOUT_SECS = 150

# sessionStart bootstraps the Investigation (one request, 3 s) and looks up
# related storyboards (2 s); Cursor runs it fire-and-forget.
SESSION_START_TIMEOUT_SECS = 10

CURSOR_DIR = Path.home() / ".cursor"
USER_MCP_PATH = CURSOR_DIR / "mcp.json"
USER_HOOKS_PATH = CURSOR_DIR / "hooks.json"
STATE_PATH = CURSOR_DIR / "cardinal.json"
SECRETS_PATH = CURSOR_DIR / "cardinal-secrets.json"
PENDING_PATH = CURSOR_DIR / "cardinal-pending.json"

DEFAULT_POLL_TIMEOUT_SECS = deviceflow.DEFAULT_POLL_TIMEOUT_SECS
DEFAULT_POLL_INTERVAL_SECS = deviceflow.DEFAULT_POLL_INTERVAL_SECS


def load_json_object(path: Path, label: str) -> dict:
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        sys.exit(f"Refusing to write: {label} ({path}) is not valid JSON ({exc}).")
    if not isinstance(data, dict):
        sys.exit(f"Refusing to write: {label} ({path}) is not a JSON object.")
    return data


def write_pending(grant: dict) -> None:
    payload = {
        "verification_uri": grant.get("verification_uri", ""),
        "user_code": grant.get("user_code", ""),
        "expires_in": grant.get("expires_in", DEFAULT_POLL_TIMEOUT_SECS),
        "written_at": datetime.now(timezone.utc).isoformat(),
        "plugin_version": PLUGIN_VERSION,
    }
    PENDING_PATH.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(PENDING_PATH, json.dumps(payload, indent=2) + "\n")


def clear_pending() -> None:
    try:
        PENDING_PATH.unlink()
    except FileNotFoundError:
        pass


# ---------------------------------------------------------------------------
# MCP config (JSON) — mcpServers.cardinal entry
# ---------------------------------------------------------------------------

def build_mcp_entry(mcp_url: str, api_key: str) -> dict:
    """A Cursor MCP entry the plugin owns end-to-end. The `cardinalManaged`
    field is metadata for disconnect — Cursor ignores unknown keys inside
    mcpServers entries. X-Cardinal-Client names this agent on every MCP
    request: Cardinal records it as the producing client of the
    investigation events posted through its MCP tools (a display claim,
    never identity)."""
    return {
        "url": mcp_url,
        "headers": {"X-CardinalHQ-API-Key": api_key, "X-Cardinal-Client": f"cursor/{PLUGIN_VERSION}"},
        "cardinalManaged": True,
        "cardinalPluginVersion": PLUGIN_VERSION,
    }


# The local cardinal-behavior MCP server (Checks preview, behavior tools): a
# stdio server Cursor runs outside its sandbox, with --runtime cursor (its
# connection is ~/.cursor/cardinal.json + cardinal-secrets.json; no key here).
BEHAVIOR_SERVER_NAME = "cardinal-behavior"
BEHAVIOR_SCRIPT = PLUGIN_ROOT / "scripts" / "cardinal-behavior"


def build_behavior_entry() -> dict:
    return {
        "command": "python3",
        "args": [str(BEHAVIOR_SCRIPT), "--runtime", "cursor"],
        "cardinalManaged": True,
        "cardinalPluginVersion": PLUGIN_VERSION,
    }


def write_mcp_config(path: Path, mcp_url: str, api_key: str, behavior: bool = True) -> Path | None:
    """The managed `cardinal` entry and, with `behavior` (the user-level
    file; a project file is for cloud agents, which have no local plugin),
    the managed `cardinal-behavior` entry. An unmanaged `cardinal` entry
    stops the write; an unmanaged `cardinal-behavior` one is left alone."""
    data = load_json_object(path, "mcp.json")
    servers = data.get("mcpServers")
    if not isinstance(servers, dict):
        servers = {}
    existing = servers.get(MCP_SERVER_NAME)
    if isinstance(existing, dict) and not existing.get("cardinalManaged"):
        sys.exit(
            f"Refusing to write because {path} already contains an unmanaged "
            f"mcpServers.{MCP_SERVER_NAME} entry. Remove or rename that entry, then rerun."
        )
    servers[MCP_SERVER_NAME] = build_mcp_entry(mcp_url, api_key)
    if behavior:
        current = servers.get(BEHAVIOR_SERVER_NAME)
        if isinstance(current, dict) and not current.get("cardinalManaged"):
            print(f"WARN {path} already has an unmanaged mcpServers.{BEHAVIOR_SERVER_NAME} entry; left as it is.")
        else:
            servers[BEHAVIOR_SERVER_NAME] = build_behavior_entry()
    data["mcpServers"] = servers

    path.parent.mkdir(parents=True, exist_ok=True)
    backup_path = backup(path)
    atomic_write(path, json.dumps(data, indent=2) + "\n")
    return backup_path


# ---------------------------------------------------------------------------
# Hooks config (JSON v1)
# ---------------------------------------------------------------------------

def managed_hook_command(event_name: str, role: str | None = None) -> str:
    """Include the plugin identity marker in the command so disconnect
    can recognize entries we own without relying on custom JSON fields.
    `role` names a second entry for the same event (its own matcher and
    timeout)."""
    role_arg = f" --role {shlex.quote(role)}" if role else ""
    return (
        f"python3 {shlex.quote(str(HOOK_SCRIPT))} "
        f"--event {shlex.quote(event_name)}{role_arg} # {HOOK_IDENTITY_MARKER}"
    )


def managed_hook_entry(event_name: str, timeout: int, role: str | None = None,
                       matcher: str | None = None) -> dict:
    entry = {
        "command": managed_hook_command(event_name, role),
        "type": "command",
        "timeout": timeout,
    }
    if matcher is not None:
        entry["matcher"] = matcher
    return entry


def strip_managed_hooks(data: dict) -> dict:
    hooks = data.get("hooks")
    if not isinstance(hooks, dict):
        data["hooks"] = {}
        return data
    for event_name, entries in list(hooks.items()):
        if not isinstance(entries, list):
            continue
        kept = [
            h for h in entries
            if not (
                isinstance(h, dict)
                and HOOK_IDENTITY_MARKER in str(h.get("command") or "")
            )
        ]
        if kept:
            hooks[event_name] = kept
        else:
            hooks.pop(event_name, None)
    data["hooks"] = hooks
    return data


def build_hooks_config(path: Path) -> dict:
    """The Cursor hooks.json v1 shape: `path`'s content with every managed
    entry replaced by the current ones.

    Events registered:
      sessionStart        — initiative-convention + budget standing; the
                            Investigation bootstrap, poller and guidance;
                            staged items; connect hint / stray-key warning
      beforeSubmitPrompt  — spend-limits gate + git_state; owner input
                            (only with --owner-input consent; detached);
                            discovery re-look (detached, staged)
      postToolUseFailure  — local evidence capture of a failed tool call +
                            the Investigation's tool-boundary deliveries
      afterFileEdit       — the edited file, for storyboard context.paths;
                            the edit lookup (staged)
      afterMCPExecution   — records which calls Cardinal's own MCP server
                            ran (postToolUse names no server)
      postToolUse         — evidence capture + turn_tool + tool_result + notify piggyback +
                            cardinal.decision recording (the sandboxed
                            `cardinal-decision record` only prints a
                            marker; this hook gates, ledgers, resolves the
                            PR via gh, and emits — hence the longer timeout)
                            + the Investigation's tool-boundary deliveries
      postToolUse (authoring) — matcher storyboard__preview|publish, 150 s:
                            the local preview render and the hero upload
      preCompact          — cardinal.plan_usage (context-window slice)
      stop                — the Investigation's turn end (flush, sync
                            check; stages, never followup_message)
      subagentStop        — subagent_usage
      afterAgentResponse  — cardinal.turn_response (text length only)
      afterAgentThought   — cardinal.turn_thought (duration + text len)
    """
    data = strip_managed_hooks(load_json_object(path, "hooks.json"))
    data.setdefault("version", 1)
    hooks = data.setdefault("hooks", {})
    for event, timeout in (
        ("sessionStart", SESSION_START_TIMEOUT_SECS),
        ("beforeSubmitPrompt", 5),
        ("postToolUse", POST_TOOL_USE_TIMEOUT_SECS),
        ("postToolUseFailure", 5),
        ("afterFileEdit", 5),
        ("afterMCPExecution", 5),
        ("preCompact", 5),
        ("stop", 10),
        ("subagentStop", 5),
        ("afterAgentResponse", 5),
        ("afterAgentThought", 5),
    ):
        hooks.setdefault(event, []).append(managed_hook_entry(event, timeout))
    hooks["postToolUse"].append(managed_hook_entry(
        "postToolUse", AUTHORING_TIMEOUT_SECS, role=AUTHORING_ROLE, matcher=AUTHORING_MATCHER))
    return data


def write_hooks_config(path: Path) -> Path | None:
    data = build_hooks_config(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    backup_path = backup(path)
    atomic_write(path, json.dumps(data, indent=2) + "\n")
    return backup_path


def repair_registration() -> list[str]:
    """Refresh, without new credentials, what an upgraded plugin registers in
    the user-level files of an existing connection: the managed hooks in
    ~/.cursor/hooks.json and the managed `cardinal-behavior` MCP entry in
    ~/.cursor/mcp.json (a connection made before the Checks preview has none;
    an upgrade moves this plugin's scripts). The managed `cardinal` entry and
    its key are left as they are; an unmanaged `cardinal-behavior` entry is
    the user's and is never replaced. Returns the paths rewritten."""
    repaired: list[str] = []
    if USER_MCP_PATH.exists():
        data = load_json_object(USER_MCP_PATH, "mcp.json")
        servers = data.get("mcpServers")
        cardinal = servers.get(MCP_SERVER_NAME) if isinstance(servers, dict) else None
        if isinstance(cardinal, dict) and cardinal.get("cardinalManaged"):
            current = servers.get(BEHAVIOR_SERVER_NAME)
            unmanaged = isinstance(current, dict) and not current.get("cardinalManaged")
            if not unmanaged and current != build_behavior_entry():
                servers[BEHAVIOR_SERVER_NAME] = build_behavior_entry()
                backup(USER_MCP_PATH)
                atomic_write(USER_MCP_PATH, json.dumps(data, indent=2) + "\n")
                repaired.append(str(USER_MCP_PATH))
    if USER_HOOKS_PATH.exists():
        before = load_json_object(USER_HOOKS_PATH, "hooks.json")
        if any(HOOK_IDENTITY_MARKER in str(h.get("command") or "")
               for entries in (before.get("hooks") or {}).values() if isinstance(entries, list)
               for h in entries if isinstance(h, dict)):
            after = build_hooks_config(USER_HOOKS_PATH)
            if after != before:
                backup(USER_HOOKS_PATH)
                atomic_write(USER_HOOKS_PATH, json.dumps(after, indent=2) + "\n")
                repaired.append(str(USER_HOOKS_PATH))
    return repaired


# ---------------------------------------------------------------------------
# Project mode target discovery
# ---------------------------------------------------------------------------

def project_root(cwd: str) -> Path | None:
    """Return the git repository root for `cwd`, or None if not a repo."""
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=cwd,
            capture_output=True,
            text=True,
            timeout=2.0,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    root = out.stdout.strip()
    return Path(root) if root else None


# ---------------------------------------------------------------------------
# State + secrets
# ---------------------------------------------------------------------------

def write_secrets(bundle: dict) -> None:
    ingest = bundle.get("ingest") or {}
    mcp = bundle.get("mcp") or {}
    payload = {
        "schema_version": 1,
        "ingest_api_key": ingest.get("api_key"),
        "ingest_api_header": ingest.get("api_header") or "x-cardinalhq-api-key",
        "mcp_api_key": mcp.get("api_key"),
        "written_at": datetime.now(timezone.utc).isoformat(),
    }
    # The control-plane token acts as the user across their orgs; it lives only
    # here (0600). migrate-from-grafana reads act_api_key / act_endpoint.
    act = deviceflow.act_credential(bundle)
    if act:
        payload["act_api_key"] = act["api_key"]
        payload["act_endpoint"] = act.get("endpoint")
    atomic_write_secret(SECRETS_PATH, json.dumps(payload, indent=2) + "\n")


def write_state(
    bundle: dict,
    host: str,
    deployment_env: str,
    telemetry_only: bool,
    installed_project_paths: dict[str, str] | None,
) -> None:
    org = bundle.get("org", {})
    user = bundle.get("user", {})
    mcp = bundle.get("mcp") or {}
    ingest = bundle.get("ingest") or {}
    mode = (
        "telemetry-only" if telemetry_only or not mcp
        else "mcp-only" if not ingest
        else "telemetry-and-mcp"
    )
    state: dict = {
        "schema_version": 1,
        "host": host,
        "mode": mode,
        "org_id": org.get("id"),
        "org_slug": org.get("slug"),
        "user_email": user.get("email"),
        "deployment_environment": deployment_env,
        "plugin_version": PLUGIN_VERSION,
        "written_at": datetime.now(timezone.utc).isoformat(),
        "user_mcp_path": str(USER_MCP_PATH),
        "user_hooks_path": str(USER_HOOKS_PATH),
        "secrets_path": str(SECRETS_PATH),
        "telemetry": {"enabled": bool(ingest)},
    }
    reason = deviceflow.ingest_unavailable_reason(bundle)
    if reason:
        # Why the server minted no ingest key, so cardinal-status can say so.
        state["telemetry"]["unavailable_reason"] = reason
    if ingest:
        state["ingest_endpoint"] = ingest.get("endpoint")
        state["ingest_key_id"] = ingest.get("key_id")
        state["ingest_key_prefix"] = (ingest.get("api_key") or "")[:8]
    if mcp:
        state["mcp_url"] = mcp.get("url")
        state["mcp_key_id"] = mcp.get("key_id")
        state["mcp_key_prefix"] = mcp.get("key_prefix") or (mcp.get("api_key") or "")[:8]
        state["mcp_created_at"] = mcp.get("created_at")
    act = deviceflow.act_credential(bundle)
    if act:
        state["act_key_id"] = act.get("key_id")
        state["act_key_prefix"] = act.get("key_prefix")
        state["act_created_at"] = act.get("created_at")
        state["act_scopes"] = deviceflow.act_granted_scopes(act)
    limits = bundle.get("limits")
    if isinstance(limits, dict) and limits.get("status_url"):
        state["limits"] = {
            "status_url": limits["status_url"],
            "enabled": bool(limits.get("enabled", True)),
        }
    if installed_project_paths:
        state["project_install"] = installed_project_paths
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    tls_state = tls.state_block(bundle, host)
    if tls_state:
        state["tls"] = tls_state
    atomic_write(STATE_PATH, json.dumps(state, indent=2) + "\n")


# ---------------------------------------------------------------------------
# Orchestration
# ---------------------------------------------------------------------------

def revoke_dropped_act_token(host: str, act: dict | None) -> None:
    """A re-connect whose bundle carries no control-plane token revokes the
    prior one server-side before its key_id leaves the state file — otherwise
    a live "acts as you" token orbits un-revokable."""
    if act:
        return
    def read(path: Path) -> dict:
        try:
            data = json.loads(path.read_text())
        except (OSError, ValueError):
            return {}
        return data if isinstance(data, dict) else {}

    prior = read(STATE_PATH)
    key_id = prior.get("act_key_id")
    if not key_id:
        return
    # Without the plaintext the server answers 403 and we point at the UI.
    plaintext = read(SECRETS_PATH).get("act_api_key")
    ok, msg = deviceflow.revoke_maestro_key(host, key_id, plaintext)
    prefix = prior.get("act_key_prefix") or key_id
    if ok:
        print(f"Revoked prior control-plane token {prefix} server-side ({msg})")
    else:
        print(f"Could not revoke prior control-plane token {prefix} ({msg}).")
        print(f"Visit {host}/settings/api-keys to revoke it manually.")


def continue_after_grant(args: argparse.Namespace, grant: dict) -> int:
    expires_in = int(grant.get("expires_in") or DEFAULT_POLL_TIMEOUT_SECS)
    interval = int(grant.get("interval") or DEFAULT_POLL_INTERVAL_SECS)
    verification_uri = grant.get("verification_uri") or ""

    print()
    print("Open this URL in your browser to approve Cardinal for Cursor:")
    print(f"  {verification_uri}")
    print()
    print(f"Waiting up to {expires_in // 60} minute(s) for browser approval...")

    try:
        bundle = deviceflow.poll_device_token(
            args.host, grant["device_code"], CLIENT_ID, interval, expires_in
        )
    except deviceflow.DeviceFlowError as exc:
        sys.exit(str(exc))
    org = bundle.get("org", {})
    user = bundle.get("user", {})
    ingest = bundle.get("ingest")
    mcp = bundle.get("mcp")
    act = deviceflow.act_credential(bundle)

    # The bundle's endpoints may sit on another hostname than the app host:
    # the same trust check, before anything probes them.
    try:
        tls.ensure_hosts_trusted(tls.connection_urls(bundle, args.host), trust=getattr(args, "trust_cert", []),
                                 command=connect_command(args))
    except tls.CertificateError as exc:
        print(str(exc), file=sys.stderr)
        return tls.EXIT_UNTRUSTED_CERT

    # Set when the server granted the other scopes but minted no ingest key
    # (org has no Lakerunner, or no ingest endpoint configured). Connect goes
    # on without telemetry as long as there is an MCP credential to wire.
    ingest_reason = deviceflow.ingest_unavailable_reason(bundle)

    if not ingest and not mcp:
        sys.exit(
            "Cardinal did not return an ingest credential "
            f"({deviceflow.ingest_unavailable_note(ingest_reason or 'unknown', mcp_connected=False)}). "
            "Nothing to connect."
        )
    if not args.telemetry_only and not mcp:
        sys.exit("Cardinal did not return an MCP credential. Check the requested scopes.")

    deployment_env = args.deployment_env or deviceflow.derive_deployment_env(args.host)

    # Resolve project install targets if --project was requested.
    project_paths: dict[str, str] | None = None
    if args.project:
        root = project_root(os.getcwd())
        if root is None:
            sys.exit(
                "cardinal-connect --project must run inside a git working "
                "tree so it can locate the project's .cursor directory."
            )
        project_mcp = root / ".cursor" / "mcp.json"
        project_hooks = root / ".cursor" / "hooks.json"
        project_paths = {
            "root": str(root),
            "mcp_path": str(project_mcp),
            "hooks_path": str(project_hooks),
        }

    if args.dry_run:
        print(json.dumps(
            {
                "org": org,
                "user": user,
                "deployment_env": deployment_env,
                "would_write": {
                    "user_mcp": str(USER_MCP_PATH) if mcp else None,
                    "user_hooks": str(USER_HOOKS_PATH),
                    "project_mcp": project_paths["mcp_path"] if project_paths and mcp else None,
                    "project_hooks": project_paths["hooks_path"] if project_paths else None,
                    "state": str(STATE_PATH),
                    "secrets": str(SECRETS_PATH),
                    "ingest_endpoint": (ingest or {}).get("endpoint"),
                    "ingest_unavailable_reason": ingest_reason,
                    "mcp_url": (mcp or {}).get("url"),
                    "act_scopes": deviceflow.act_granted_scopes(act) if act else None,
                },
            },
            indent=2,
        ))
        return 0

    # No ingest credential: nothing to probe, and no telemetry config to
    # write — skip rather than abort so the MCP config still gets written.
    if ingest:
        ok, msg = deviceflow.verify_ingest_reachable(ingest)
        if not ok:
            sys.exit(f"Ingest reachability failed: {msg}")
        print(f"Ingest endpoint reachable ({msg})")

    if mcp:
        ok, msg = deviceflow.verify_mcp_reachable(mcp.get("url"), mcp.get("api_key"))
        if not ok:
            sys.exit(f"MCP reachability failed: {msg}")
        print(f"MCP endpoint reachable ({msg})")

    if not HOOK_SCRIPT.exists():
        sys.exit(f"Telemetry hook script is missing: {HOOK_SCRIPT}")

    # Write user-level configs FIRST — they never depend on the project.
    if mcp:
        b = write_mcp_config(USER_MCP_PATH, mcp["url"], mcp["api_key"])
        print(f"Wrote Cardinal MCP entry to {USER_MCP_PATH}")
        if b:
            print(f"MCP backup: {b}")

    revoke_dropped_act_token(args.host, act)
    write_secrets(bundle)
    print(f"Wrote Cardinal local secrets to {SECRETS_PATH}")

    b = write_hooks_config(USER_HOOKS_PATH)
    print(f"Wrote Cardinal hooks to {USER_HOOKS_PATH}")
    if b:
        print(f"Hooks backup: {b}")

    if project_paths:
        if mcp:
            b = write_mcp_config(Path(project_paths["mcp_path"]), mcp["url"], mcp["api_key"], behavior=False)
            print(f"Wrote Cardinal MCP entry to {project_paths['mcp_path']} (cloud-agent path)")
            if b:
                print(f"Project MCP backup: {b}")
        b = write_hooks_config(Path(project_paths["hooks_path"]))
        print(f"Wrote Cardinal hooks to {project_paths['hooks_path']} (cloud-agent path)")
        if b:
            print(f"Project hooks backup: {b}")

    write_state(bundle, args.host, deployment_env, args.telemetry_only, project_paths)
    print(f"Wrote Cardinal state to {STATE_PATH}")

    print()
    print(f"Connected as {user.get('email') or 'unknown'} ({org.get('slug') or org.get('id')})")
    if ingest:
        print(f"Telemetry endpoint: {ingest['endpoint']}")
    else:
        print(f"WARN {deviceflow.ingest_unavailable_note(ingest_reason or 'unknown', mcp_connected=bool(mcp))}")
        print("     Re-run cardinal-connect --rotate once telemetry ingest is available.")
    if mcp:
        print(f"MCP endpoint: {mcp['url']}")
    if act:
        granted = deviceflow.act_granted_scopes(act)
        print(f"Actions: enabled ({', '.join(granted)}, key {act.get('key_prefix')})")
        missing = [s for s in getattr(args, "extra_scopes", []) if s not in granted]
        if missing:
            print(f"WARN Not granted: {', '.join(missing)} — the server didn't grant them "
                  "(your org role, or this Cardinal server doesn't offer them yet).")
    elif getattr(args, "act_requested", False):
        print("WARN Cardinal returned no control-plane token: skills that write dashboards or")
        print("     alert rules as you (migrate-from-grafana) need a login token or API key.")
    if project_paths:
        print(f"Project install root: {project_paths['root']}")
        print(
            "Commit .cursor/mcp.json and .cursor/hooks.json to your repo so "
            "cloud agents pick them up."
        )
    for line in tls.runtime_lines("cursor", bundle, args.host):
        print(line)
    print()
    print("Restart Cursor so it reloads MCP and hook config, then run cardinal-status.")
    return 0


# ---------------------------------------------------------------------------
# Owner-input consent (--owner-input on|off)
# ---------------------------------------------------------------------------

CONFIRM_WORD = "yes"


def owner_input_consent(on: bool, *, home: Path | None = None, stdin=None, stdout=None) -> int:
    """Print the full consent text, then record the answer
    (owner_input.set_consent, versioned by the text's sha256). `on` needs
    the user to type "yes" in an interactive terminal: the agent's own
    shell must not consent on the user's behalf. Exit code."""
    from cardinal_core import owner_input

    home = Path.home() if home is None else home
    stdin = sys.stdin if stdin is None else stdin
    stdout = sys.stdout if stdout is None else stdout
    text = owner_input.consent_text("cursor")
    path = owner_input.consent_path("cursor", home)
    stdout.write("Cardinal owner input for Cursor\n\n" + text + "\n\n")
    if on:
        if not (hasattr(stdin, "isatty") and stdin.isatty()):
            stdout.write("Not recorded: run this in your own terminal and type yes when asked "
                         "(it cannot be answered for you).\n")
            return 2
        stdout.write(f'Type "{CONFIRM_WORD}" to turn owner input on for Cursor on this machine: ')
        stdout.flush()
        answer = (stdin.readline() or "").strip().lower()
        if answer != CONFIRM_WORD:
            stdout.write("Not recorded: owner input stays off.\n")
            return 1
    try:
        owner_input.set_consent("cursor", home, on)
    except (OSError, ValueError) as exc:
        stdout.write(f"Could not record it in {path}: {exc}\n")
        return 1
    if on:
        stdout.write(f"Owner input is ON for Cursor on this machine (recorded in {path}). It applies to "
                     "sessions whose Investigation turns owner input on; new Cursor chats pick it up.\n")
        if owner_input.kill_switch("cursor", home, os.environ):
            stdout.write(f"Note: the kill switch is set (CARDINAL_OWNER_INPUT=0, or "
                         f"{owner_input.kill_switch_path(home)}), so nothing is recorded until you remove it.\n")
    else:
        stdout.write(f"Owner input is OFF for Cursor on this machine (recorded in {path}). Queued prompts "
                     "are deleted, not sent.\n")
    stdout.write("Run `cardinal-connect --owner-input off` to stop; CARDINAL_OWNER_INPUT=0 or "
                 f'{{"cursor": "off"}} in {owner_input.kill_switch_path(home)} turns it off whatever this '
                 "file says.\n")
    return 0


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="cardinal-connect",
        description="Connect Cursor to Cardinal's unified MCP endpoint.",
    )
    parser.add_argument(
        "--host",
        default="https://app.cardinalhq.io",
        help="Cardinal app host (default: https://app.cardinalhq.io)",
    )
    parser.add_argument(
        "--rotate",
        action="store_true",
        help="Proceed even if Cardinal state already exists and mint a fresh key.",
    )
    parser.add_argument(
        "--telemetry-only",
        action="store_true",
        help="Only configure Cardinal telemetry hooks; skip the MCP credential.",
    )
    parser.add_argument(
        "--project",
        action="store_true",
        help=(
            "Additionally write .cursor/mcp.json and .cursor/hooks.json at the "
            "current git repository root so Cursor cloud agents (which do not "
            "load ~/.cursor/) pick up the Cardinal wiring."
        ),
    )
    parser.add_argument(
        "--deployment-env",
        default=None,
        help="Override deployment.environment (default derived from --host).",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Run the device-code flow and print what would be written.",
    )
    parser.add_argument(
        "--owner-input", choices=("on", "off"), default=None,
        help="Don't connect: record whether this machine's Cursor sessions may record the prompts you "
             "type as owner input of their Cardinal Investigation. Prints what you consent to; `on` "
             "asks you to type yes.",
    )
    parser.add_argument(
        "scopes", nargs="*", metavar="SCOPE",
        help="Extra scopes for the control-plane token: "
             f"{', '.join(deviceflow.ACT_EXTRA_SCOPES)} (space- or comma-separated). "
             "All are requested by default; naming them only matters with "
             "--minimal-scopes. They let agents create/edit dashboards and alert "
             "rules, and query telemetry (read-only), as you — within your org role.",
    )
    parser.add_argument(
        "--minimal-scopes", action="store_true",
        help="Don't request the control-plane token and its extra scopes by default — "
             "only those named as positional args (none: no token). Skills that write "
             "dashboards or alert rules as you (migrate-from-grafana) then need a "
             "reconnect or an org API key.",
    )
    parser.add_argument(
        "--trust-cert", action="append", default=[], metavar="SHA256",
        help="Trust the certificate with this SHA-256 fingerprint for the host "
             "that presents it (a self-hosted Cardinal behind a self-signed "
             "certificate). Connect shows the fingerprint and asks only when "
             "the machine does not already trust the host; repeatable.",
    )
    args = parser.parse_args()
    try:
        args.named_scopes = deviceflow.parse_act_scopes(args.scopes)
    except ValueError as exc:
        parser.error(str(exc))
    return args


def connect_command(args: argparse.Namespace) -> str:
    """How to re-run this connect (shown when a certificate needs --trust-cert)."""
    parts = ["cardinal-connect"]
    if args.host != "https://app.cardinalhq.io":
        parts += ["--host", args.host]
    for flag in ("rotate", "telemetry_only", "minimal_scopes"):
        if getattr(args, flag, False):
            parts.append("--" + flag.replace("_", "-"))
    return " ".join(parts)


def main() -> int:
    args = parse_args()

    if args.owner_input is not None:
        return owner_input_consent(args.owner_input == "on")

    if STATE_PATH.exists() and not args.rotate:
        try:
            prior = json.loads(STATE_PATH.read_text())
        except Exception:
            prior = {}
        user = prior.get("user_email") or "this account"
        # Re-running on an existing connection refreshes the user-level hook
        # and cardinal-behavior registration in place (an upgraded plugin),
        # credentials unchanged. --project files still need --rotate --project.
        repaired = repair_registration()
        if repaired:
            print("Refreshed the Cardinal registration (credentials unchanged):")
            for path in repaired:
                print(f"  {path}")
            print(f"Cardinal is already connected as {user}. Restart Cursor so it reloads MCP and hook config.")
            return 0
        sys.stderr.write(
            f"Cardinal is already connected as {user}. "
            "Re-run with --rotate to overwrite.\n"
        )
        return 2

    scopes = ["ingest:write"]
    if not args.telemetry_only:
        scopes.append("mcp:invoke")
    # The control-plane token (maestro:act) and its extra scopes, so skills can
    # write dashboards / alert rules and query telemetry as the user. Requested
    # by default; scopes the user named are required, the rest are dropped by a
    # Cardinal server that doesn't offer them yet.
    named = args.named_scopes
    extra = deviceflow.default_act_scopes(named, args.minimal_scopes)
    act_scopes = ["maestro:act", *extra] if extra else []
    required = scopes + (["maestro:act", *named] if named else [])
    print(f"Requesting Cardinal consent for scopes: {', '.join(scopes + act_scopes)}")
    if act_scopes:
        print("WARN maestro:act grants a long-lived token that acts as you across your orgs.")
        print(f"     It is stored 0600 in {SECRETS_PATH}; cardinal-disconnect revokes it.")
        for line in deviceflow.act_scope_warnings(extra):
            print(line)
    # A host whose certificate this machine does not trust (self-hosted,
    # self-signed) is shown and pinned with the user's consent first; a
    # trusted host passes silently. docs/specs/tls-trust.md.
    try:
        tls.ensure_trusted(args.host, trust=getattr(args, "trust_cert", []), command=connect_command(args))
    except tls.CertificateError as exc:
        print(str(exc), file=sys.stderr)
        return tls.EXIT_UNTRUSTED_CERT
    try:
        grant, requested = deviceflow.start_device_code_with_fallback(
            args.host, required, act_scopes, CLIENT_ID)
        args.act_requested = "maestro:act" in requested
        args.extra_scopes = [s for s in extra if s in requested]
    except deviceflow.DeviceFlowError as exc:
        sys.exit(str(exc))
    write_pending(grant)
    try:
        return continue_after_grant(args, grant)
    finally:
        clear_pending()


if __name__ == "__main__":
    sys.exit(main())
